rules_version = '2';

// Monilog Web (project monilog-28535). Every user's ledger lives under
// users/{uid}/... and is readable/writable only by that authenticated user.
// The WhatsApp chatbot (a future Cloud Function) will write with the same uid.
//
// NOTE: this project shares the Firebase project with the landing page and the
// Flutter app, and this is the only rules file in the repo — so it must also
// cover the beta-tester collections the landing page uses, or deploying from
// here would break its invite-code gate.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Invite codes handed to partner organizations. Signed-in clients look a code
    // up to validate it during registration; nobody may write one from a client.
    // Deliberately readable by any authenticated user: validation happens after
    // sign-up on both the web app and the landing page.
    match /beta-codes/{codeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // One document per tester, keyed by Firebase uid. A tester may only read and
    // write their own row, so the roster cannot be enumerated from a client.
    match /testers/{testerId} {
      allow read, write: if request.auth != null && request.auth.uid == testerId;
    }
  }
}
